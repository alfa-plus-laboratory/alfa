{
  "name": "alfa",
  "version": "0.8.0",
  "description": "Local-first coding agent for the terminal",
  "license": "Apache-2.0",
  "homepage": "https://github.com/alfa-plus-laboratory/alfa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alfa-plus-laboratory/alfa.git"
  },
  "bugs": "https://github.com/alfa-plus-laboratory/alfa/issues",
  "type": "module",
  "private": true,
  "bin": {
    "alfa": "./bin/alfa"
  },
  "scripts": {
    "dev": "bun run bin/alfa",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile --outfile bin/alfa-bin src/cli/main.ts",
    "test": "bun test",
    "start": "bun run bin/alfa"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/openai-compatible": "^3.0.27",
    "ai": "^7.0.58",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "typescript": "^7.0.2"
  }
}
